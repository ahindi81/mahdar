# Required on the server (Render → Environment)
GEMINI_API_KEY=
# Server-to-server database access (matches the hash in the mahdar-admin Supabase function)
MAHDAR_ADMIN_SECRET=
# Meeting bot (recall.ai): API key, region of your Recall workspace, webhook verification secret (whsec_...)
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_WEBHOOK_SECRET=
# Email (HTTP only; Render free plan blocks SMTP). Free option: Gmail via Google Apps Script (see docs/gmail-sender.gs).
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
# Or Brevo / Resend:
BREVO_API_KEY=
# RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Mahdar
APP_URL=https://mahdar.onrender.com
# Optional overrides
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEMINI_TEXT_MODEL=
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
